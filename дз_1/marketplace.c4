specification {
  element actor // пользователь: покупатель / продавец
  element system // сущность маркетплейса
  element service // внутрениие сервисы
  element database // postgres
  element external_system // внешние api
  element queue // kafka 
  element component 
}

model {
  buyer = actor "Покупатель" {
    description 'Пользователь маркетплейса. Регистрируется и далее получает релевантные товары, которые выдаются по его истории покупок, выбирает их, добавляя в корзину, а далее оплачивает и забирает в пунктах выдачи.'
  }

  seller = actor "Продавец" {
    description 'Лицо, предлагающее различные товары на маркетплейсе. Следит за наличием своего товара, размещает новый.'
  }

  pickup_point = actor "Сущность пункта выдачи заказов" {
    description 'Нужно для выделение отдельного лица, ответственного за выдачу заказов'
  }

  payment_provider = external_system "Внешний платежный провайдер" {
    description 'Позволяет осуществлять оплату через QR / СБП или по карте'
  }

  marketplace = system "Маркетплейс" {
    description 'Площадка, которая позволяет произвести покупку товаров, представленных продавцами, покупателям.'

    ui_app = service "Приложение / сайт (UI)" {
      description 'Интерфейс маркетплейса: приложение как инструмент работы покупателя и продавца'
    }

    api_gateway = service "API Gateway" {
      description 'Единая точка входа в backend: маршрутизация запросов UI, агрегация, базовая авторизация.'
    }


    users_auth = service "Регистрация и авторизация пользователей" {
      description 'Регистрация или вход в ui для покупателей и продавцов. Выдача ролей и доступов.'

      users_auth_api = component 'Auth API'
      token_manager = component 'Менеджер токенов'
      roles_access = component 'Роли и доступы'
      users_repo = component 'Хранилище пользователей'

      users_auth_api -> token_manager 'выдача токена'
      users_auth_api -> roles_access 'назначение роли/проверка доступа'
      users_auth_api -> users_repo 'создание/поиск пользователя'
    }

    catalog_ml = service "Рекомандательная лента" {
      description 'Выдача рекомендательной ленты пользователю на основе предсказаний модели.'

      feed_api = component 'Feed API'
      candidates_builder = component 'Генерация кандидатов'
      ml_ranker = component 'ML ранжирование'
      fallback_rules = component 'Правила плана Б: новый пользователь, модель недоступна'
      features_store = component 'Фичи пользователя (внутреннее хранилище)' 

      feed_api -> candidates_builder 'получить кандидатов'
      candidates_builder -> features_store 'использование истории/признаков'
      candidates_builder -> ml_ranker 'кандидаты'
      ml_ranker -> features_store 'использование истории/признаков'
      feed_api -> fallback_rules 'если модель недоступна'
    }

    catalog = service "Каталог" {
      description 'Сервис для получения карточки товаров'

      catalog_api = component 'Catalog API'
      product_writer = component 'Редактирование товаров'
      stock_price = component 'Цена и остатки'
      catalog_repo = component 'Хранилище каталога'

      catalog_api -> catalog_repo 'получить карточку'
      product_writer -> catalog_repo 'создать/изменить товар'
      stock_price -> catalog_repo 'обновить цену/остаток'
    }

    search = service "Поиск товара" {
      description 'Поиск конкретного товара пользователем по фотографии, названию или же штрих-коду'

      search_api = component 'Search API'
      query_parser = component 'Разбор запроса'
      indexer = component 'Индексатор'
      search_index = component 'Поисковый индекс'

      search_api -> query_parser 'нормализация запроса'
      search_api -> search_index 'поиск'
      indexer -> search_index 'обновление индекса'
    }

    cart = service "Корзина" {
      description 'Корзина покупателей: выбранные ими, еще неоплаченные товары'

      cart_api = component 'Cart API'
      cart_storage = component 'Хранилище корзины'
      cart_pricing = component 'Пересчет суммы'
      cart_validator = component 'Проверка наличия/цены'

      cart_api -> cart_storage 'читать/писать'
      cart_api -> cart_validator 'проверка'
      cart_validator -> cart_pricing 'допуск к пересчету'
    }

    notify_provider = service "Внутренний сервис отправки уведомлений пользователям" {
      description 'Нужен для оповещения: к примеру, напомнить продавцу о заканчивающемся товаре или покупателю о заканчивающемся сроке хранения заказа.'

      notify_api = component 'Notify API'
      templates = component 'Шаблоны сообщений'
      dispatcher = component 'Диспетчер отправки'
      preferences = component 'Настройки уведомлений'
      rate_limits = component 'Лимиты и антиспам'

      notify_api -> preferences 'учет настроек'
      dispatcher -> templates 'рендер сообщения'
      dispatcher -> rate_limits 'контроль частоты'
    }
    
    orders = service "Сервис оформления и возврата заказов" {
      description 'Сервис, отвечающий за оформление заказа. Его задача зарезервировать товар и дождаться проведение оплаты. В случае возврата заказов он отвечает за доставку товаров в распределительный центр и возврат товара на баланс продавца.'

      orders_api = component 'Orders API'
      order_state = component 'Машина статусов'
      reservation = component 'Резервирование товара'
      returns_flow = component 'Возвраты'
      orders_repo = component 'Хранилище заказов'
      outbox_orders = component 'Outbox событий'

      orders_api -> order_state 'команды'
      order_state -> reservation 'резерв/возврат'
      order_state -> returns_flow 'обработка возврата'
      order_state -> orders_repo 'сохранение'
      order_state -> outbox_orders 'события'
      outbox_orders -> kafka 'публикация событий'
    }

    payments = service 'Сервис платежей' {
      description 'Создаёт оплату у провайдера, проверяет статусы платежей и подтверждает результат для заказа.'

      payments_api = component 'Payments API'
      provider_adapter = component 'Адаптер провайдера'
      status_poller = component 'Проверка статуса платежа'
      payment_state = component 'Статусы платежа'
      payments_repo = component 'Хранилище платежей'
      outbox_payments = component 'Outbox событий'

      payments_api -> provider_adapter 'инициация оплаты'
      provider_adapter -> payment_provider 'инициация оплаты'
      status_poller -> payment_provider 'проверка статуса'
      status_poller -> payment_state 'обновление статуса'
      payment_state -> payments_repo 'сохранение'
      payment_state -> outbox_payments 'события'
      outbox_payments -> kafka 'публикация событий'
    }

    kafka = queue 'Kafka' {
      description 'Шина событий для уведомлений.'
    }

    users_db = database 'Postgres: users' {
      description 'Все зарегестрированные пользователи и их роли'
    }
    catalog_db = database 'Postgres: catalog' {
      description 'БД всех товаров'
    }
    orders_db = database 'Postgres: orders' {
      description 'Все существующие заказа: выполненные и в процессе.'
    }
    payments_db = database 'Postgres: payments' {
      description 'Платежи и их статусы, id провайдера и история подтверждений.'
    }

    buyer -> ui_app 'взаимодействие'
    seller -> ui_app 'взаимодействие'

    ui_app -> api_gateway 'HTTP API'

    api_gateway -> users_auth 'регистрация/вход'
    api_gateway -> catalog_ml 'получение персональной ленты'
    api_gateway -> search 'поиск'
    api_gateway -> cart 'изменение корзины'
    api_gateway -> orders 'оформление/статусы'
    api_gateway -> notify_provider 'настройки уведомлений'
    api_gateway -> catalog 'получение карточки товара'
    api_gateway -> payments 'оплата заказа'

    users_auth -> users_db 'читает/пишет'
    catalog -> catalog_db 'читает/пишет'
    orders -> orders_db 'читает/пишет'
    payments -> payments_db 'читает/пишет'

    catalog_ml -> catalog 'получает кандидатов/метаданные для ранжирования'
    catalog -> search 'данные для индекса'
    search -> catalog 'детали товара по результатам поиска'

    cart -> catalog 'проверка товара (цена/остаток)'
    orders -> catalog 'резерв/возврат товара'

    orders -> payments 'создать оплату для заказа'
    payments -> payment_provider 'инициация оплаты'
    payments -> orders 'подтверждение оплаты/ошибка'
    payments -> kafka 'события по платежам'

    orders -> kafka 'события по заказам'
    kafka -> notify_provider 'триггеры уведомлений'

    pickup_point -> orders 'подтверждение выдачи/возврата'
    orders -> pickup_point 'передача статуса: готов к выдаче/отмена'
    buyer -> pickup_point 'получение заказа'
  }
}

views {
  view context {
    title "L1: Диаграмма контекста"
    include buyer
    include seller
    include pickup_point
    include payment_provider
    include marketplace
  }

  view containers of marketplace {
    title "L2: Диаграмма контейнеров"
    include marketplace
    include buyer
    include seller
    include pickup_point
    include payment_provider
    include ui_app
    include api_gateway
    include users_auth
    include catalog_ml
    include catalog
    include search
    include cart
    include orders
    include payments
    include notify_provider
    include kafka
    include users_db
    include catalog_db
    include orders_db
    include payments_db
  }

  view orders_components of orders {
    title "L3: Компоненты контейнера Orders"
    include *
  }

  view payments_components of payments {
    title "L3: Компоненты контейнера Payments"
    include *
  }

  view catalog_ml_components of catalog_ml {
    title "L3: Компоненты контейнера Рекомандательная лента"
    include *
  }

  view auth_components of users_auth {
    title "L3: Компоненты контейнера Регистрация и авторизация пользователей"
    include *
  }

  view catalog_components of catalog {
    title "L3: Компоненты контейнера Каталог"
    include *
  }

  view search_components of search {
    title "L3: Компоненты контейнера Поиск товара"
    include *
  }

  view cart_components of cart {
    title "L3: Компоненты контейнера Корзина"
    include *
  }

  view notify_components of notify_provider {
    title "L3: Компоненты контейнера Внутренний сервис отправки уведомлений пользователям"
    include *
  }

  view l3_all_components of marketplace {
    title "L3: Все компоненты сервисов (одна схема)"
    include buyer
    include seller
    include pickup_point
    include payment_provider
    include ui_app
    include api_gateway
    include users_auth
    include catalog_ml
    include catalog
    include search
    include cart
    include orders
    include payments
    include notify_provider
    include kafka
    include users_db
    include catalog_db
    include orders_db
    include payments_db
    include users_auth.*
    include catalog_ml.*
    include catalog.*
    include search.*
    include cart.*
    include orders.*
    include payments.*
    include notify_provider.*
  }

  view checkout_flow of marketplace {
    title "Поток: оформление и оплата заказа"
    include buyer
    include ui_app
    include api_gateway
    include cart
    include orders
    include payments
    include payment_provider
    include kafka
    include notify_provider
    include catalog
    include catalog_db
    include orders_db
    include payments_db
  }

  view seller_flow of marketplace {
    title "Поток: работа продавца с товарами и заказами"
    include seller
    include ui_app
    include users_db
    include api_gateway
    include users_auth
    include catalog
    include orders
    include notify_provider
    include kafka
    include catalog_db
    include orders_db
  }

  view pickup_flow of marketplace {
    title "Поток: выдача и возврат в пункте выдачи"
    include pickup_point
    include buyer
    include orders
    include kafka
    include notify_provider
    include orders_db
  }
}