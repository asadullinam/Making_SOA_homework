          "pluginVersion": "4.15.0",
          "queryType": "table",
          "rawSql": "SELECT\n  cohort_date,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 0), 0), 2) AS day_0,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 1), 0), 2) AS day_1,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 2), 0), 2) AS day_2,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 3), 0), 2) AS day_3,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 4), 0), 2) AS day_4,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 5), 0), 2) AS day_5,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 6), 0), 2) AS day_6,\n  round(100 * ifNull(maxIf(retention_rate, lifecycle_day = 7), 0), 2) AS day_7\nFROM movie_analytics.retention_cohorts FINAL\nGROUP BY cohort_date\nORDER BY cohort_date",
          "refId": "A"
        }
      ],
      "title": "Retention Cohort Heatmap",
      "type": "table"
